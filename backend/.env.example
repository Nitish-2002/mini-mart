# Shared, project-wide
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/minimart

# Test suites (TASK-AUTH-017 onward) read backend/.env.test instead of this
# file — see tests/conftest.py. Point it at a disposable database, never a
# real one; that file is gitignored (.env.*) and never committed.

# AUTH module secrets (trd.md §10a Configuration Surface) — never commit real values
JWT_SIGNING_SECRET=change-me-in-real-environments
OTP_HMAC_PEPPER=change-me-in-real-environments
RESEND_API_KEY=change-me-in-real-environments

# Singleton Admin seed, read once by the first migration (TASK-AUTH-005) —
# never commit real values here, this repo is public.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-before-running-the-migration-for-real
